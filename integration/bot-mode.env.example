# Copy into the operator's secret environment; never commit real values.
BOT_SESSION_SECRET=replace-with-at-least-32-random-characters
BOT_INTERNAL_SECRET=replace-with-at-least-32-random-characters
BOT_PUBLIC_BASE_URL=https://your-hermes-origin.example
BOT_ALLOWED_ORIGINS=https://your-hermes-origin.example
BOT_DEFAULT_MODEL=gpt-5.6-luna
# Optional desktop supervisor endpoint. Leave the secret empty when desktop
# actions are disabled.
BOT_DESKTOP_SECRET=
BOT_DESKTOP_URL=http://127.0.0.1:9121

