# Copy into the service environment and replace every placeholder.
BOT_ENV=production
BOT_BIND_HOST=127.0.0.1
BOT_BIND_PORT=9120
BOT_DATABASE_PATH=/var/lib/hermes-bot-mode/bot-mode.sqlite3
BOT_WORKSPACE_ROOT=/var/lib/hermes-bot-mode/workspaces
BOT_PUBLIC_BASE_URL=https://your-hermes-origin.example
BOT_ALLOWED_ORIGINS=https://your-hermes-origin.example
BOT_INTERNAL_SECRET=replace-with-a-random-32-byte-or-longer-secret
BOT_SESSION_SECRET=replace-with-a-different-random-32-byte-or-longer-secret
BOT_COOKIE_SECURE=true
# Set only after the real Codex app-server runtime is installed and signed in.
BOT_RUNTIME=unavailable


